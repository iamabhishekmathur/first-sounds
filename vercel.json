{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/*.js": { "maxDuration": 20, "memory": 1024, "includeFiles": "{data/sounds.json,js/syncdoc.js,js/logic.js}" }
  },
  "headers": [
    { "source": "/api/(.*)", "headers": [{ "key": "cache-control", "value": "no-store" }] }
  ]
}
